[Unit]
Description=Progect-shop Vite dev server
After=network.target

[Service]
Type=simple
WorkingDirectory=/path/to/Progect-shop    # replace with actual path
ExecStart=/usr/bin/env npm run dev
Restart=always
RestartSec=5
User=%i
Environment=NODE_ENV=development

[Install]
WantedBy=multi-user.target
